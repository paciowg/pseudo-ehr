                            <%= form.hidden_field "toc[sections][][code]", value: section['code'] %>
                            <%= form.hidden_field "toc[sections][][code_system]", value: section['code_system'] %>
                            <%= form.hidden_field "toc[sections][][display]", value: section['display'] %>
