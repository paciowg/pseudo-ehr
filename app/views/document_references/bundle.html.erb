<div class="xl:mt-6 lg:mt-10 md:mt-12 sm:mt-32 lg:ml-64 w-full lg:w-3/4 h-full">
  <div class="w-11/12">
    <div class="mb-6">
      <%= link_to '← Back to Document References', patient_document_references_path(params[:patient_id]), class: 'text-blue-600 hover:text-blue-800' %>
    </div>

    <% if @bundle_error.present? %>
      <div class="p-4 bg-red-100 text-red-800 rounded border border-red-200">
        <%= @bundle_error %>
      </div>
    <% else %>
      <% toc_view = toc_bundle_view_model(@bundle) %>

      <% if toc_view.present? %>
        <div class="space-y-6">
          <div class="bg-white border border-gray-200 rounded-lg shadow p-6">
            <h1 class="text-2xl font-semibold text-gray-900"><%= toc_view[:title].presence || 'Transitions of Care Bundle' %></h1>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
              <div class="rounded-lg border border-gray-200 p-4 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Patient</h2>
                <% if toc_view[:patient].present? %>
                  <div class="mt-2 space-y-1 text-sm text-gray-800">
                    <div><span class="font-medium">Name:</span> <%= toc_view[:patient][:name] %></div>
                    <% if toc_view[:patient][:dob].present? %>
                      <div><span class="font-medium">DOB:</span> <%= toc_view[:patient][:dob] %></div>
                    <% end %>
                    <% if toc_view[:patient][:gender].present? %>
                      <div><span class="font-medium">Gender:</span> <%= toc_view[:patient][:gender].to_s.titleize %></div>
                    <% end %>
                    <% if toc_view[:patient][:mrn].present? %>
                      <div><span class="font-medium">MRN:</span> <%= toc_view[:patient][:mrn] %></div>
                    <% end %>
                    <% if toc_view[:patient][:address].present? %>
                      <div><span class="font-medium">Address:</span> <%= toc_view[:patient][:address] %></div>
                    <% end %>
                    <% toc_view[:patient][:telecom].to_a.each do |line| %>
                      <div><%= line %></div>
                    <% end %>
                  </div>
                <% else %>
                  <p class="mt-2 text-sm text-gray-600">No patient details available.</p>
                <% end %>
              </div>

              <div class="rounded-lg border border-gray-200 p-4 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Author</h2>
                <% if toc_view[:author].present? %>
                  <div class="mt-2 space-y-1 text-sm text-gray-800">
                    <div><span class="font-medium">Name:</span> <%= toc_view[:author][:name] %></div>
                    <% if toc_view[:author][:role].present? %>
                      <div><span class="font-medium">Role:</span> <%= toc_view[:author][:role] %></div>
                    <% end %>
                    <% if toc_view[:author][:organization].present? %>
                      <div><span class="font-medium">Organization:</span> <%= toc_view[:author][:organization] %></div>
                    <% end %>
                  </div>
                <% else %>
                  <p class="mt-2 text-sm text-gray-600">No author details available.</p>
                <% end %>
              </div>

              <div class="rounded-lg border border-gray-200 p-4 bg-gray-50">
                <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Custodian</h2>
                <% if toc_view[:custodian].present? %>
                  <div class="mt-2 space-y-1 text-sm text-gray-800">
                    <div><span class="font-medium">Name:</span> <%= toc_view[:custodian][:name] %></div>
                    <% if toc_view[:custodian][:address].present? %>
                      <div><span class="font-medium">Address:</span> <%= toc_view[:custodian][:address] %></div>
                    <% end %>
                    <% toc_view[:custodian][:telecom].to_a.each do |line| %>
                      <div><%= line %></div>
                    <% end %>
                  </div>
                <% else %>
                  <p class="mt-2 text-sm text-gray-600">No custodian details available.</p>
                <% end %>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <% toc_view[:sections].each do |section| %>
              <div class="bg-white border border-gray-200 rounded-lg shadow">
                <div class="border-b border-gray-200 px-6 py-4">
                  <div class="flex flex-col gap-1 md:flex-row md:items-center md:justify-between">
                    <h2 class="text-lg font-semibold text-gray-900"><%= section[:title] %></h2>
                    <% if section[:code].present? || section[:code_display].present? %>
                      <div class="text-sm text-gray-500">
                        <%= [section[:code_display], section[:code].presence && "(#{section[:code]})"].compact.join(' ') %>
                      </div>
                    <% end %>
                  </div>
                </div>

                <div class="px-6 py-4">
                  <% if section[:items].present? %>
                    <div class="space-y-3">
                      <% section[:items].each do |item| %>
                        <div class="rounded border border-gray-200 bg-gray-50 p-4">
                          <div class="font-medium text-gray-900"><%= item[:heading] %></div>

                          <% if item[:meta].present? %>
                            <ul class="mt-2 list-disc pl-5 text-sm text-gray-700 space-y-1">
                              <% item[:meta].each do |meta_item| %>
                                <li><%= meta_item %></li>
                              <% end %>
                            </ul>
                          <% end %>

                          <% if item[:children].present? %>
                            <div class="mt-3 space-y-2">
                              <% item[:children].each do |child| %>
                                <div class="rounded border border-gray-200 bg-white p-3">
                                  <div class="font-medium text-gray-800"><%= child[:heading] %></div>
                                  <% if child[:meta].present? %>
                                    <ul class="mt-1 list-disc pl-5 text-sm text-gray-700 space-y-1">
                                      <% child[:meta].each do |meta_item| %>
                                        <li><%= meta_item %></li>
                                      <% end %>
                                    </ul>
                                  <% end %>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="rounded bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 text-sm">
                      <%= section[:empty_message] || 'No entries in this section.' %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="p-4 bg-yellow-100 text-yellow-800 rounded border border-yellow-200">
          Bundle loaded but no displayable TOC Composition was found.
        </div>
      <% end %>
    <% end %>
  </div>
</div>
